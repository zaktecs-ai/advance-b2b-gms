# Copy to `.env` and fill in. Reference values in config.yaml as ${VAR}.

# --- AI personalized pitch hook (OPTIONAL) --------------------------------
# Set ai_hook.enabled: true in config.yaml, then paste ONE key below.
# Leave empty to keep the rule-based hook (no breakage).
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Proxy (OPTIONAL) -----------------------------------------------------
# NOTE: the app does NOT read HTTP_PROXY/HTTPS_PROXY via os.environ.
# To use a proxy, reference it INSIDE config.yaml, e.g.:
#   proxy:
#     http: ${HTTP_PROXY}
# and define it here:
# HTTP_PROXY=http://user:pass@host:port

# --- Headed browser / VNC (OPTIONAL) --------------------------------------
# Only needed when maps.headless: false and you run the browser on an X/VNC
# display. Set by vnc-screen.sh; do not set manually unless you know the target.
# DISPLAY=:2
# XAUTHORITY=/home/youruser/.Xauthority

# --- Console cosmetics (OPTIONAL) -----------------------------------------
# NO_COLOR=1            # disable ANSI color in the progress console
